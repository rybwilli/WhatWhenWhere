              "  return v;",
              "}",
              "",
              "function caller(ctx) {",
              "  const identity = ctx.identity || {};",
              "  return { sub: identity.sub, email: lower(identity.claims && identity.claims.email) };",
              "}",
              "",
              "function isOwner(o, who) {",
              "  return (!!who.sub && o.ownerSub === who.sub) || (!!who.email && lower(o.ownerEmail) === who.email);",
              "}",
              "",
              "function respondentFor(o, who) {",
              "  if (!who.email) return null;",
              "  return asList(o.respondents).find((r) => r && lower(r.email) === who.email) || null;",
              "}",
              "",
              "function canAccess(o, who) {",
              "  return o.allowPublic === true || isOwner(o, who) || !!respondentFor(o, who);",
              "}",
              "",

              "  }",
              "  return {",
              "    expression: '#u = :prevUpdatedAt',",
              "    expressionNames: { '#u': 'updatedAt' },",
              "    expressionValues: util.dynamodb.toMapValues({ ':prevUpdatedAt': prev.updatedAt }),",
              "  };",
              "}",
              "",
              "function writeRequest(ctx) {",
              "  const prev = ctx.stash.prev;",
              "  const key = util.dynamodb.toMapValues({ id: prev.id });",
              "  const condition = unchangedSinceLoad(prev);",
              "  if (ctx.info.fieldName === 'removeOccasion') {",
              "    return { operation: 'DeleteItem', key, condition };",
              "  }",
              "  const changes = { ...ctx.stash.changes, updatedAt: util.time.nowISO8601() };",
              "  const names = {};",
              "  const values = {};",
              "  const sets = [];",
              "  const removes = [];",
              "  Object.keys(changes).forEach((f, i) => {",
              "    names['#f' + i] = f;",
              "    if (changes[f] === null) {",
              "      removes.push('#f' + i);",
              "    } else {",
              "      values[':v' + i] = changes[f];",
              "      sets.push('#f' + i + ' = :v' + i);",
              "    }",
              "  });",
              "  const expression = 'SET ' + sets.join(', ') + (removes.length ? ' REMOVE ' + removes.join(', ') : '');",
              "  return {",
              "    operation: 'UpdateItem',",
              "    key,",
              "    update: { expression, expressionNames: names, expressionValues: util.dynamodb.toMapValues(values) },",
              "    condition,",
              "  };",
              "}",
              "",
              "function writeResponse(ctx) {",
              "  if (ctx.error) {",
              "    if (ctx.error.type && ctx.error.type.indexOf('ConditionalCheckFailed') >= 0) {",
              "      util.error('The occasion changed while saving. Try again.', 'ConflictError');",
              "    }",
              "    util.error(ctx.error.message, ctx.error.type);",
              "  }",
              "  return ctx.result;",
              "}",
              "",
              "export function request(ctx) {",
              "  return writeRequest(ctx);",
              "}",
              "",
              "export function response(ctx) {",
              "  return writeResponse(ctx);",
              "}"

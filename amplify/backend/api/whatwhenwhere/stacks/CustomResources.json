              "}",
              "",
              "function mergeOwnPlayerOfDayVote(prev, nextValue, who) {",
              "  const votes = asList(prev.playerOfDayVotes);",
              "  const sent = asList(nextValue).find((v) => v && lower(v.voterId) === who.email) || null;",
              "  const existing = votes.find((v) => v && lower(v.voterId) === who.email) || null;",
              "  if (!sent) return votes; // clearing a Player of the Day vote isn't a feature",
              "  if (existing && existing.votedForId === sent.votedForId) return votes;",
              "  const deadline = prev.playerOfDayDeadline;",
              "  const open = prev.occasionType === 'Pick Up Game' && prev.status === 'finalized' &&",
              "    (!deadline || util.time.nowEpochMilliSeconds() < util.time.parseISO8601ToEpochMilliSeconds(deadline));",
              "  if (!open) util.unauthorized();",
              "  const vote = compact({",
              "    voterId: who.email,",
              "    voter: sent.voter,",
              "    votedForId: sent.votedForId,",
              "    votedForName: sent.votedForName,",
              "    timestamp: util.time.nowISO8601(),",
              "  });",
              "  return [...votes.filter((v) => !(v && lower(v.voterId) === who.email)), vote];",
              "}",
              "",
              "function participantChanges(prev, input, who) {",

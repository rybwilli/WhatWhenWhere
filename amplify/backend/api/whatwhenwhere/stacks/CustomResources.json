              "  'finalLocation', 'finalNotes', 'infoText', 'infoUrl', 'allowPublic',",
              "  'playerOfDayVotes', 'playerOfDayDeadline',",
              "];",
              "const PARTICIPANT_FIELDS = ['whenOptions', 'whereOptions', 'respondents', 'playerOfDayVotes'];",

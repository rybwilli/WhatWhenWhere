              "  }",
              "  return changes;",
              "}",
              "",
              "// Replace only the caller's votes on each option the caller sent.",
              "function mergeOwnVotes(prev, field, nextValue, who) {",
              "  const mine = {};",
              "  asList(nextValue).forEach((opt) => {",
              "    if (!opt || !opt.id) return;",
              "    const v = asList(opt.votes).find((x) => voterKey(x) === who.email);",
              "    mine[opt.id] = { vote: v || null };",
              "  });",
              "  return asList(prev[field]).map((opt) => {",
              "    const sent = mine[opt.id];",
              "    if (!sent) return opt;",
              "    const votes = asList(opt.votes);",
              "    const existing = votes.find((x) => voterKey(x) === who.email) || null;",

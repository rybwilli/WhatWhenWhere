              "    }",
              "  });",
              "  const expression = 'SET ' + sets.join(', ') + (removes.length ? ' REMOVE ' + removes.join(', ') : '');",
              "  return {",
              "    operation: 'UpdateItem',",
              "    key,",
              "    update: { expression, expressionNames: names, expressionValues: util.dynamodb.toMapValues(values) },",

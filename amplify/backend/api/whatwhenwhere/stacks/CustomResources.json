              "      voter: sent.vote.voter,",
              "      voterId: who.email,",
              "      response: sent.vote.response,",
              "      comment: sent.vote.comment,",
              "      timestamp: sent.vote.timestamp,",
              "    });",
              "    return { ...opt, votes: [...others, vote] };",
              "  });",
              "}",
              "",
              "function mergeSelfJoin(prev, nextValue, who) {",

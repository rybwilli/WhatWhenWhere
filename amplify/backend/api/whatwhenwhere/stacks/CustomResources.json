              "  return (!!who.sub && o.ownerSub === who.sub) || (!!who.email && lower(o.ownerEmail) === who.email);",
              "}",
              "",
              "function respondentFor(o, who) {",
              "  if (!who.email) return null;",
              "  return asList(o.respondents).find((r) => r && lower(r.email) === who.email) || null;",
              "}",
              "",
              "function canAccess(o, who) {",
              "  return o.allowPublic === true || isOwner(o, who) || !!respondentFor(o, who);",
              "}",
              "",
              "function isOrganizer(o, who) {",
              "  if (isOwner(o, who)) return true;",
              "  const r = respondentFor(o, who);",
              "  return !!(r && r.coOrganizer === true);",
              "}",
              "",
              "function voterKey(v) {",
              "  return lower(v && (v.voterId || v.voter));",
              "}",
              "",
              "function sameVote(a, b) {",
              "  if (!a && !b) return true;",
              "  if (!a || !b) return false;",
              "  return a.response === b.response && (a.comment || '') === (b.comment || '');",
              "}",
              "",
              "// Owner-only: co-organizer flags may not change, and co-organizers may not be removed.",
              "function checkCoOrganizers(prev, next) {",
              "  const before = {};",
              "  asList(prev.respondents).forEach((r) => {",
              "    if (r) before[lower(r.email)] = r.coOrganizer === true;",
              "  });",
              "  const after = {};",
              "  asList(next).forEach((r) => {",
              "    if (!r) return;",
              "    const key = lower(r.email);",
              "    after[key] = true;",
              "    if ((r.coOrganizer === true) !== (before[key] === true)) util.unauthorized();",
              "  });",
              "  Object.keys(before).forEach((key) => {",
              "    if (before[key] && !after[key]) util.unauthorized();",
              "  });",
              "}",
              "",
              "function organizerChanges(prev, input, who) {",
              "  const changes = {};",
              "  EDIT_FIELDS.forEach((f) => {",
              "    if (input[f] === undefined) return;",
              "    changes[f] = JSON_FIELDS.includes(f) && input[f] !== null ? asList(input[f]) : input[f];",
              "  });",
